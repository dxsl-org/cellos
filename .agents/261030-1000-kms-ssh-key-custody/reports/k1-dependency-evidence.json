 "recommendation_D_K4": {
  "choice": "own minimal OpenSSH-v1 parser with allowlist (bcrypt + aes256-ctr, rounds 1..64, salt 16..64) before KDF",
  "ranking": [
   "own minimal",
   "hybrid (ssh-key w/o encryption + own KDF/CTR)",
   "ssh-key + encryption"
  ],
  "reasons": [
   "contract allowlist is structural, not convention (ssh-key parses any rounds/salt, links chacha/gcm)",
   "smallest compiled set, no pre-release crate in KMS (-91,680 B text vs ssh-key+encryption)",
   "bcrypt_pbkdf_with_memory + zeroize features give controllable memory hygiene (ssh-key decrypt uses the unzeroized stack buffer, enables neither zeroize feature)",
   "3 new lock packages, 0 new deny diagnostics"
  ],
  "risks": [
   "~100 lines of untrusted-input parsing in a locked signer: fuzz + differential oracle (ssh-key+encryption as dev-dependency only)",
   "must replicate checkint/padding/public-key equality/pub==derive(seed)",
   "two SHA-2 majors in KMS (size only)",
   "cipher-none branch not built in probe",
   "evidence-only recommendation; decision belongs to the user"
  ]
 },
