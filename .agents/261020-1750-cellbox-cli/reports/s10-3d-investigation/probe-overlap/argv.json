[
  "qemu-system-x86_64",
  "-machine",
  "q35",
  "-accel",
  "tcg",
  "-cpu",
  "qemu64,+pdpe1gb,+rdrand,+rdseed",
  "-m",
  "256M",
  "-display",
  "none",
  "-serial",
  "file:/tmp/cellbox-s10-3d-investigation/probe-overlap/serial.log",
  "-qmp",
  "unix:/tmp/cellbox-s10-3d-investigation/probe-overlap/qmp.sock,server=on,wait=off",
  "-monitor",
  "none",
  "-drive",
  "file=/tmp/cellbox-s10-3d-investigation/instrumented/probe.iso,media=cdrom,readonly=on,format=raw",
  "-boot",
  "d",
  "-no-reboot",
  "-netdev",
  "user,id=net0",
  "-device",
  "e1000,netdev=net0",
  "-drive",
  "file=/tmp/cellbox-s10-3d-investigation/probe-overlap/disk.img,if=none,format=raw,id=p10fx",
  "-device",
  "nvme,drive=p10fx,serial=cellosp10",
  "-trace",
  "enable=pci_nvme_*,file=/tmp/cellbox-s10-3d-investigation/probe-overlap/nvme.trace",
  "-trace",
  "enable=pci_cfg_write"
]
