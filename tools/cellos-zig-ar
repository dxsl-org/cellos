"""
cellos-zig-ar: Archiver wrapper using Zig toolchain (zig ar).
Handles path conversions transparently when running Windows zig.exe under WSL.
"""

import sys
import os
import subprocess
import shutil

def resolve_zig():
    bin_env = os.environ.get("CELLOS_ZIG_BIN")
    if bin_env and os.path.exists(bin_env):
        return bin_env
    z = shutil.which("zig")
    if z:
        return z
    for candidate in ("/mnt/c/zig/zig.exe", "C:\\zig\\zig.exe", "/usr/local/bin/zig", "/usr/bin/zig"):
        if os.path.exists(candidate):
            return candidate
    print("cellos-zig-ar: zig binary not found. Set CELLOS_ZIG_BIN or install Zig.", file=sys.stderr)
    sys.exit(127)

def to_win_path(p):
    if not p:
        return p
    if p.startswith("-"):
        return p
    try:
        abs_p = os.path.abspath(p)
        res = subprocess.run(["wslpath", "-w", abs_p], capture_output=True, text=True, check=True)
        return res.stdout.strip()
    except Exception:
        return p

def main():
    zig_bin = resolve_zig()
    is_win_zig = zig_bin.lower().endswith(".exe")

    raw_args = sys.argv[1:]
    out_args = []
    for arg in raw_args:
        if is_win_zig and ("/" in arg or "\\" in arg or os.path.exists(arg) or arg.endswith((".a", ".o"))):
            out_args.append(to_win_path(arg))
        else:
            out_args.append(arg)

    cmd = [zig_bin, "ar"] + out_args
    res = subprocess.run(cmd)
    sys.exit(res.returncode)

if __name__ == "__main__":
    main()
