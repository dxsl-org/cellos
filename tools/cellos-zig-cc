#!/usr/bin/env python3
# SPDX-License-Identifier: MPL-2.0
"""
cellos-zig-cc: Unified C/C++ cross-compiler wrapper using Zig toolchain (zig cc / zig c++).

Translates GCC/Clang architecture flags (e.g. -march=rv64gc -> -mcpu=generic_rv64+m+a+f+d+c)
and maps target triples to Zig freestanding targets across riscv64, aarch64, and x86_64.
Transparently handles Windows WSL path conversions when running Windows zig.exe under WSL.
"""

import sys
import os
import subprocess
import shutil

def resolve_zig():
    bin_env = os.environ.get("CELLOS_ZIG_BIN")
    if bin_env and os.path.exists(bin_env):
        return bin_env
    z = shutil.which("zig")
    if z:
        return z
    for candidate in ("/mnt/c/zig/zig.exe", "C:\\zig\\zig.exe", "/usr/local/bin/zig", "/usr/bin/zig"):
        if os.path.exists(candidate):
            return candidate
    print("cellos-zig-cc: zig binary not found. Set CELLOS_ZIG_BIN or install Zig.", file=sys.stderr)
    sys.exit(127)

def to_win_path(p):
    if not p:
        return p
    # If p looks like a flag without a path (e.g. -fPIC, -O2), leave as-is
    if p.startswith("-") and not p.startswith(("-I", "-L", "-o", "-include")):
        return p
    # Convert path to absolute POSIX path first, then to Windows UNC path
    try:
        abs_p = os.path.abspath(p)
        res = subprocess.run(["wslpath", "-w", abs_p], capture_output=True, text=True, check=True)
        return res.stdout.strip()
    except Exception:
        return p

def main():
    zig_bin = resolve_zig()
    is_win_zig = zig_bin.lower().endswith(".exe")

    # Determine C vs C++ mode
    caller = os.path.basename(sys.argv[0]).lower()
    subcmd = "c++" if ("cxx" in caller or "c++" in caller or "++" in caller) else "cc"

    # Identify target architecture
    target = os.environ.get("TARGET", os.environ.get("CELLOS_C_TARGET", ""))
    raw_args = sys.argv[1:]

    for i, a in enumerate(raw_args):
        if a.startswith("--target="):
            target = a.split("=", 1)[1]
        elif a == "-target" and i + 1 < len(raw_args):
            target = raw_args[i + 1]

    zig_target = None
    extra_flags = []

    if "riscv" in target:
        zig_target = "riscv64-freestanding-none"
        extra_flags = ["-mabi=lp64d", "-mcpu=generic_rv64+m+a+f+d+c", "-fPIC"]
    elif "aarch64" in target:
        zig_target = "aarch64-freestanding-none"
        extra_flags = ["-mgeneral-regs-only", "-fPIC"]
    elif "x86_64" in target:
        zig_target = "x86_64-freestanding-none"
        extra_flags = ["-mno-red-zone", "-mcmodel=small", "-fPIC"]

    # Filter and adapt arguments
    out_args = []
    i = 0
    while i < len(raw_args):
        arg = raw_args[i]

        # Filter out GCC-specific -march on RISC-V that Zig rejects
        if arg.startswith("-march=rv64") or arg == "-march=rv64gc":
            i += 1
            continue
        # Strip redundant or generic target flags to avoid conflicts
        if arg.startswith("--target="):
            i += 1
            continue
        if arg == "-target":
            i += 2
            continue

        # Path translation for Windows Zig under WSL
        if is_win_zig:
            if arg.startswith("-I") and len(arg) > 2:
                inc = arg[2:]
                out_args.append("-I" + to_win_path(inc))
                i += 1
                continue
            elif arg.startswith("-L") and len(arg) > 2:
                lib = arg[2:]
                out_args.append("-L" + to_win_path(lib))
                i += 1
                continue
            elif arg in ("-I", "-L", "-o", "-include") and i + 1 < len(raw_args):
                next_arg = raw_args[i + 1]
                out_args.append(arg)
                out_args.append(to_win_path(next_arg))
                i += 2
                continue
            elif ("/" in arg or "\\" in arg or os.path.exists(arg)) and not arg.startswith("-"):
                out_args.append(to_win_path(arg))
                i += 1
                continue

        out_args.append(arg)
        i += 1

    final_cmd = [zig_bin, subcmd]
    if zig_target:
        final_cmd.extend(["-target", zig_target])
        final_cmd.extend(extra_flags)

    # Inject freestanding overlay include if available
    repo_root = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
    freestanding_inc = os.path.join(repo_root, "third_party", "freestanding-include")
    if os.path.isdir(freestanding_inc):
        inc_path = to_win_path(freestanding_inc) if is_win_zig else freestanding_inc
        final_cmd.append("-I" + inc_path)

    final_cmd.extend(out_args)

    # Execute
    res = subprocess.run(final_cmd)
    sys.exit(res.returncode)

if __name__ == "__main__":
    main()
