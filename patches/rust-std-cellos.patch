+use crate::time::Duration;
+
+const SYS_GET_TIME: usize = 120;
+
+#[inline(always)]
+unsafe fn sys_get_time() -> u64 {
+    let ret: isize;
+    #[cfg(target_arch = "riscv64")]
+    core::arch::asm!(
+        "ecall",
+        inlateout("a0") 0usize => ret,
+        in("a1") 0usize,
+        in("a2") 0usize,
+        in("a3") 0usize,
+        in("a7") SYS_GET_TIME,
+        options(nostack, preserves_flags)
+    );
+    #[cfg(target_arch = "aarch64")]
+    core::arch::asm!(
+        "svc #0",
+        inlateout("x0") SYS_GET_TIME => ret,
+        in("x1") 0usize,
+        in("x2") 0usize,
+        in("x3") 0usize,
+        in("x4") 0usize,
+        options(nostack, preserves_flags)
+    );
+    #[cfg(target_arch = "x86_64")]
+    core::arch::asm!(
+        "syscall",
+        inlateout("rax") SYS_GET_TIME => ret,
+        in("rdi") 0usize,
+        in("rsi") 0usize,
+        in("rdx") 0usize,
+        in("r10") 0usize,
+        lateout("rcx") _,
+        lateout("r11") _,
+        options(nostack, preserves_flags)
+    );
+    if ret >= 0 { ret as u64 } else { 0 }
+}
+
+#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord, Debug, Hash)]
+pub struct Instant(u64);
+
+impl Instant {
+    pub fn now() -> Instant {
+        Instant(unsafe { sys_get_time() })
+    }
+
+    pub fn checked_sub_instant(&self, other: &Instant) -> Option<Duration> {
+        let diff_ticks = self.0.checked_sub(other.0)?;
+        // 10 MHz clock: 1 tick = 100 ns
+        Some(Duration::from_nanos(diff_ticks.saturating_mul(100)))
+    }
+
    pub fn checked_add_duration(&self, other: &Duration) -> Option<Instant> {
        let add_ticks = (other.as_nanos() / 100) as u64;
        self.0.checked_add(add_ticks).map(Instant)
    }

    pub fn checked_sub_duration(&self, other: &Duration) -> Option<Instant> {
        let sub_ticks = (other.as_nanos() / 100) as u64;
        self.0.checked_sub(sub_ticks).map(Instant)
    }
}
