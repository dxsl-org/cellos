diff --git a/library/std/src/sys/pal/cellos/alloc.rs b/library/std/src/sys/pal/cellos/alloc.rs
new file mode 100644
index 0000000..ef7cf20
--- /dev/null
+++ b/library/std/src/sys/pal/cellos/alloc.rs
@@ -0,0 +1,99 @@
// SPDX-License-Identifier: MPL-2.0
// CellOS Tier 1 SAS Per-Cell Freeing Heap Allocator (4 MiB, 16-byte aligned, coalescing).
use crate::alloc::Layout;

const HEAP_SIZE: usize = 4 * 1024 * 1024;
const ALIGN: usize = 16;
const HEADER_SIZE: usize = 16;

#[repr(align(16))]
struct HeapStorage([u8; HEAP_SIZE]);
static mut HEAP_MEM: HeapStorage = HeapStorage([0; HEAP_SIZE]);
static mut INITIALIZED: bool = false;

#[repr(C)]
struct BlockHeader {
    size: usize,
    is_free: usize,
}

unsafe fn init_heap() {
    let base = core::ptr::addr_of_mut!(HEAP_MEM.0) as *mut BlockHeader;
    (*base).size = HEAP_SIZE;
    (*base).is_free = 1;
    INITIALIZED = true;
}

#[inline]
pub unsafe fn alloc(layout: Layout) -> *mut u8 {
    let size = layout.size();
    if size == 0 {
        return layout.align().max(ALIGN) as *mut u8;
    }
    if !INITIALIZED {
        init_heap();
    }

    let req_payload = (size + ALIGN - 1) & !(ALIGN - 1);
    let needed = req_payload + HEADER_SIZE;

    let heap_start = core::ptr::addr_of_mut!(HEAP_MEM.0) as usize;
    let heap_end = heap_start + HEAP_SIZE;

    let mut curr = heap_start;
    while curr < heap_end {
        let hdr = curr as *mut BlockHeader;
        let bsize = (*hdr).size;
        if bsize < HEADER_SIZE || curr + bsize > heap_end {
            return core::ptr::null_mut();
        }

        if (*hdr).is_free == 1 && bsize >= needed {
            if bsize >= needed + HEADER_SIZE + ALIGN {
                let next = (curr + needed) as *mut BlockHeader;
                (*next).size = bsize - needed;
                (*next).is_free = 1;
                (*hdr).size = needed;
            }
            (*hdr).is_free = 0;
            return (curr + HEADER_SIZE) as *mut u8;
        }

        curr += bsize;
    }

    core::ptr::null_mut()
}

#[inline]
pub unsafe fn dealloc(ptr: *mut u8, layout: Layout) {
    if layout.size() == 0 || ptr.is_null() {
        return;
    }
    let heap_start = core::ptr::addr_of_mut!(HEAP_MEM.0) as usize;
    let heap_end = heap_start + HEAP_SIZE;
    let p = ptr as usize;

    if p < heap_start + HEADER_SIZE || p >= heap_end {
        return;
    }

    let hdr = (p - HEADER_SIZE) as *mut BlockHeader;
    (*hdr).is_free = 1;

    let mut curr = heap_start;
    while curr < heap_end {
        let cur_hdr = curr as *mut BlockHeader;
        let bsize = (*cur_hdr).size;
        if bsize < HEADER_SIZE || curr + bsize > heap_end {
            break;
        }

        let next = curr + bsize;
        if next < heap_end {
            let next_hdr = next as *mut BlockHeader;
            if (*cur_hdr).is_free == 1 && (*next_hdr).is_free == 1 {
                (*cur_hdr).size += (*next_hdr).size;
                continue;
            }
        }

        curr += (*cur_hdr).size;
    }
}
