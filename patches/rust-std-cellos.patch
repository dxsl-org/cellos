+const SYS_GET_RANDOM: usize = 214;
+
+/// Secure entropy hook obeying PAL-019 (no dev-weak-rng) and PAL-031 (buffer validation).
+pub fn fill_bytes(bytes: &mut [u8]) {
+    if bytes.is_empty() {
+        return;
+    }
+    // PAL-031: Validate pointer bounds and non-null before issuing syscall
+    let ptr = bytes.as_mut_ptr();
+    if ptr.is_null() {
+        panic!("PAL-031: null pointer rejected");
+    }
+    let addr = ptr as usize;
+    if addr.checked_add(bytes.len()).is_none() {
+        panic!("PAL-031: buffer range overflow rejected");
+    }
+
+    let mut offset = 0;
+    while offset < bytes.len() {
+        let chunk_len = core::cmp::min(bytes.len() - offset, 64);
+        let chunk = &mut bytes[offset..offset + chunk_len];
+        let chunk_ptr = chunk.as_mut_ptr() as usize;
+        let ret: isize;
+
+        #[cfg(target_arch = "riscv64")]
+        unsafe {
+            core::arch::asm!(
+                "ecall",
+                inlateout("a0") chunk_ptr => ret,
+                in("a1") chunk_len,
+                in("a2") 0usize,
+                in("a3") 0usize,
+                in("a7") SYS_GET_RANDOM,
+                options(nostack, preserves_flags)
+            );
+        }
+        #[cfg(target_arch = "aarch64")]
+        unsafe {
+            core::arch::asm!(
+                "svc #0",
+                inlateout("x0") SYS_GET_RANDOM => ret,
+                in("x1") chunk_ptr,
+                in("x2") chunk_len,
+                in("x3") 0usize,
+                in("x4") 0usize,
+                options(nostack, preserves_flags)
+            );
+        }
+        #[cfg(target_arch = "x86_64")]
+        unsafe {
+            core::arch::asm!(
+                "syscall",
+                inlateout("rax") SYS_GET_RANDOM => ret,
+                in("rdi") chunk_ptr,
+                in("rsi") chunk_len,
+                in("rdx") 0usize,
+                in("r10") 0usize,
+                lateout("rcx") _,
+                lateout("r11") _,
+                options(nostack, preserves_flags)
+            );
+        }
+
+        // PAL-019: Fail-closed without synthetic fallback
+        if ret <= 0 {
+            panic!("PAL-019: GetRandom returned zero or error; entropy unavailable");
+        }
+        offset += ret as usize;
+    }
+}
diff --git a/library/std/src/sys/pal/cellos/thread.rs b/library/std/src/sys/pal/cellos/thread.rs
new file mode 100644
index 0000000..153ff96
--- /dev/null
+++ b/library/std/src/sys/pal/cellos/thread.rs
@@ -0,0 +1,439 @@
+use crate::boxed::Box;
+use crate::io;
+use crate::num::NonZero;
+use crate::sync::atomic::Atomic;
+use crate::thread::ThreadInit;
+use crate::time::Duration;
+
+pub struct Thread {
+    tid: usize,
+}
+
+unsafe impl Send for Thread {}
+unsafe impl Sync for Thread {}
+
+pub const DEFAULT_MIN_STACK_SIZE: usize = 1 << 20;
+
+const SYS_SPAWN: usize = 5;
+const SYS_WAIT: usize = 8;
+const SYS_SET_TLS_BASE: usize = 9;
+const SYS_EXIT: usize = 60;
+const SYS_YIELD: usize = 104;
+const SYS_GET_CPU_COUNT: usize = 263;
+
+unsafe fn sys_spawn(entry: usize, arg: usize) -> usize {
+    let tid: usize;
+    #[cfg(target_arch = "riscv64")]
+    core::arch::asm!(
+        "ecall",
+        inlateout("a0") entry => tid,
+        in("a1") arg,
+        in("a2") 0usize,
+        in("a3") 0usize,
+        in("a7") SYS_SPAWN,
+        options(nostack, preserves_flags)
+    );
+    #[cfg(target_arch = "aarch64")]
+    core::arch::asm!(
+        "svc #0",
+        inlateout("x0") SYS_SPAWN => tid,
+        in("x1") entry,
+        in("x2") arg,
+        in("x3") 0usize,
+        in("x4") 0usize,
+        options(nostack, preserves_flags)
+    );
+    #[cfg(target_arch = "x86_64")]
+    core::arch::asm!(
+        "syscall",
+        inlateout("rax") SYS_SPAWN => tid,
+        in("rdi") entry,
+        in("rsi") arg,
+        in("rdx") 0usize,
+        in("r10") 0usize,
+        lateout("rcx") _,
+        lateout("r11") _,
+        options(nostack, preserves_flags)
+    );
+    #[cfg(not(any(target_arch = "riscv64", target_arch = "aarch64", target_arch = "x86_64")))]
+    {
+        let _ = (entry, arg);
+        tid = 0;
+    }
+    tid
+}
+
+unsafe fn sys_wait(tid: usize) -> usize {
+    let ret: usize;
+    #[cfg(target_arch = "riscv64")]
+    core::arch::asm!(
+        "ecall",
+        inlateout("a0") tid => ret,
+        in("a1") 0usize,
+        in("a2") 0usize,
+        in("a3") 0usize,
+        in("a7") SYS_WAIT,
+        options(nostack, preserves_flags)
+    );
+    #[cfg(target_arch = "aarch64")]
+    core::arch::asm!(
+        "svc #0",
+        inlateout("x0") SYS_WAIT => ret,
+        in("x1") tid,
+        in("x2") 0usize,
+        in("x3") 0usize,
+        in("x4") 0usize,
+        options(nostack, preserves_flags)
+    );
+    #[cfg(target_arch = "x86_64")]
+    core::arch::asm!(
+        "syscall",
+        inlateout("rax") SYS_WAIT => ret,
+        in("rdi") tid,
+        in("rsi") 0usize,
+        in("rdx") 0usize,
+        in("r10") 0usize,
+        lateout("rcx") _,
+        lateout("r11") _,
+        options(nostack, preserves_flags)
+    );
+    #[cfg(not(any(target_arch = "riscv64", target_arch = "aarch64", target_arch = "x86_64")))]
+    {
+        let _ = tid;
+        ret = 0;
+    }
+    ret
+}
+
+unsafe fn sys_exit(code: usize) -> ! {
+    #[cfg(target_arch = "riscv64")]
+    core::arch::asm!(
+        "ecall",
+        in("a0") code,
+        in("a1") 0usize,
+        in("a2") 0usize,
+        in("a3") 0usize,
+        in("a7") SYS_EXIT,
+        options(noreturn)
+    );
+    #[cfg(target_arch = "aarch64")]
+    core::arch::asm!(
+        "svc #0",
+        in("x0") SYS_EXIT,
+        in("x1") code,
+        in("x2") 0usize,
+        in("x3") 0usize,
+        in("x4") 0usize,
+        options(noreturn)
+    );
+    #[cfg(target_arch = "x86_64")]
+    core::arch::asm!(
+        "syscall",
+        in("rax") SYS_EXIT,
+        in("rdi") code,
+        in("rsi") 0usize,
+        in("rdx") 0usize,
+        in("r10") 0usize,
+        options(noreturn)
+    );
+    #[cfg(not(any(target_arch = "riscv64", target_arch = "aarch64", target_arch = "x86_64")))]
+    loop {}
+}
+
+unsafe fn sys_set_tls_base(base: usize) -> usize {
+    let ret: usize;
+    #[cfg(target_arch = "riscv64")]
+    core::arch::asm!(
+        "ecall",
+        inlateout("a0") base => ret,
+        in("a1") 0usize,
+        in("a2") 0usize,
+        in("a3") 0usize,
+        in("a7") SYS_SET_TLS_BASE,
+        options(nostack, preserves_flags)
+    );
+    #[cfg(target_arch = "aarch64")]
+    core::arch::asm!(
+        "svc #0",
+        inlateout("x0") SYS_SET_TLS_BASE => ret,
+        in("x1") base,
+        in("x2") 0usize,
+        in("x3") 0usize,
+        in("x4") 0usize,
+        options(nostack, preserves_flags)
+    );
+    #[cfg(target_arch = "x86_64")]
+    core::arch::asm!(
+        "syscall",
+        inlateout("rax") SYS_SET_TLS_BASE => ret,
+        in("rdi") base,
+        in("rsi") 0usize,
+        in("rdx") 0usize,
+        in("r10") 0usize,
+        lateout("rcx") _,
+        lateout("r11") _,
+        options(nostack, preserves_flags)
+    );
+    #[cfg(not(any(target_arch = "riscv64", target_arch = "aarch64", target_arch = "x86_64")))]
+    {
+        let _ = base;
+        ret = 0;
+    }
+    ret
+}
+
+#[cfg(target_thread_local)]
+#[allow(non_upper_case_globals)]
+unsafe extern "C" {
+    // Bounds of the TLS initial image, exported by the cell linker script
+    // (`libs/cell-build/src/cell.ld.in`): `.tdata` bytes up to `__tdata_end`,
+    // `.tbss` zeros up to `__tbss_end`; `__tls_align_mark - __tdata_start` is
+    // the segment alignment.
+    static __tdata_start: u8;
+    static __tdata_end: u8;
+    static __tbss_end: u8;
+    static __tls_align_mark: u8;
+}
+
+/// Where a thread's TLS block holds the image and the thread pointer. The
+/// offsets are the ones the linker baked into every local-exec access.
+#[cfg(target_thread_local)]
+struct TlsLayout {
+    block: crate::alloc::Layout,
+    image: usize,
+    filesz: usize,
+    tp: usize,
+}
+
+#[cfg(target_thread_local)]
+unsafe fn tls_layout() -> TlsLayout {
+    let start = core::ptr::addr_of!(__tdata_start) as usize;
+    let filesz = core::ptr::addr_of!(__tdata_end) as usize - start;
+    let memsz = core::ptr::addr_of!(__tbss_end) as usize - start;
+    let align = (core::ptr::addr_of!(__tls_align_mark) as usize - start).max(1);
+    // Variant II: the image ends at the thread pointer, which holds a self-pointer.
+    #[cfg(target_arch = "x86_64")]
+    let (image, tp, size) = {
+        let tp = memsz.next_multiple_of(align);
+        (0, tp, tp + size_of::<usize>())
+    };
+    // Variant I: a 16-byte TCB at the thread pointer, then the aligned image.
+    #[cfg(target_arch = "aarch64")]
+    let (image, tp, size) = {
+        let image = 16usize.next_multiple_of(align);
+        (image, 0, image + memsz)
+    };
+    // Variant I without a TCB (riscv64): the thread pointer is the image itself.
+    #[cfg(not(any(target_arch = "x86_64", target_arch = "aarch64")))]
+    let (image, tp, size) = (0, 0, memsz);
+    match crate::alloc::Layout::from_size_align(size.max(1), align.max(16)) {
+        Ok(block) => TlsLayout { block, image, filesz, tp },
+        Err(_) => super::abort_internal(),
+    }
+}
+
+#[cfg(target_thread_local)]
+pub unsafe fn setup_thread_tls() -> *mut u8 {
+    let layout = tls_layout();
+    let block = crate::sys::pal::alloc::alloc(layout.block);
+    // Without its own block the thread would keep its creator's thread pointer
+    // and share that thread's thread-locals.
+    if block.is_null() {
+        super::abort_internal();
+    }
+    core::ptr::write_bytes(block, 0, layout.block.size());
+    core::ptr::copy_nonoverlapping(
+        core::ptr::addr_of!(__tdata_start),
+        block.add(layout.image),
+        layout.filesz,
+    );
+    let tp = block.add(layout.tp);
+    // A small image need not leave the thread pointer word-aligned.
+    #[cfg(target_arch = "x86_64")]
+    (tp as *mut usize).write_unaligned(tp as usize);
+    sys_set_tls_base(tp as usize);
+    block
+}
+
+#[cfg(target_thread_local)]
+pub unsafe fn teardown_thread_tls(block: *mut u8) {
+    crate::sys::pal::alloc::dealloc(block, tls_layout().block);
+}
+
+#[cfg(target_thread_local)]
+static MAIN_TLS_READY: Atomic<bool> = crate::sync::atomic::AtomicBool::new(false);
+
+/// Gives the root task its TLS block; only the first call allocates.
+#[cfg(target_thread_local)]
+pub unsafe fn setup_main_thread_tls() {
+    if !MAIN_TLS_READY.swap(true, crate::sync::atomic::Ordering::Relaxed) {
+        unsafe { setup_thread_tls() };
+    }
+}
+
+// Cells enter through ostd's `_start`, which runs `.init_array` but never std's
+// `lang_start`; without this hook the root task would address its thread-locals
+// off a null thread pointer.
+#[cfg(target_thread_local)]
+#[used]
+#[unsafe(link_section = ".init_array.00099")]
+static MAIN_TLS_INIT: extern "C" fn() = main_tls_init;
+
+#[cfg(target_thread_local)]
+extern "C" fn main_tls_init() {
+    unsafe { setup_main_thread_tls() }
+}
+
+impl Thread {
+    // unsafe: see thread::Builder::spawn_unchecked for safety requirements
+    pub unsafe fn new(_stack: usize, init: Box<ThreadInit>) -> io::Result<Thread> {
+        let data = Box::into_raw(init);
+        let tid = unsafe { sys_spawn(thread_start as usize, data as usize) };
+
+        if tid == 0 || tid == usize::MAX {
+            unsafe {
+                drop(Box::from_raw(data));
+            }
+            return Err(io::const_error!(
+                io::ErrorKind::Uncategorized,
+                "unable to create thread"
+            ));
+        } else {
+            return Ok(Thread { tid });
+        }
+
+        extern "C" fn thread_start(data: usize) {
+            #[cfg(target_thread_local)]
+            let tls_ptr = unsafe { setup_thread_tls() };
+
+            let init = unsafe { Box::from_raw(data as *mut ThreadInit) };
+            let rust_start = init.init();
+            rust_start();
+
+            #[cfg(target_thread_local)]
+            unsafe {
+                crate::sys::thread_local::destructors::run();
+                crate::rt::thread_cleanup();
+                teardown_thread_tls(tls_ptr);
+            }
+            #[cfg(not(target_thread_local))]
+            crate::rt::thread_cleanup();
+
+            unsafe {
+                sys_exit(0);
+            }
+        }
+    }
+
+    pub fn join(self) {
+        unsafe {
+            let _ = sys_wait(self.tid);
+        }
+    }
+}
+
+pub fn available_parallelism() -> io::Result<NonZero<usize>> {
+    let count: usize;
+    #[cfg(target_arch = "riscv64")]
+    unsafe {
+        core::arch::asm!(
+            "ecall",
+            inlateout("a0") 0usize => count,
+            in("a1") 0usize,
+            in("a2") 0usize,
+            in("a3") 0usize,
+            in("a7") SYS_GET_CPU_COUNT,
+            options(nostack, preserves_flags)
+        );
+    }
+    #[cfg(target_arch = "aarch64")]
+    unsafe {
+        core::arch::asm!(
+            "svc #0",
+            inlateout("x0") SYS_GET_CPU_COUNT => count,
+            in("x1") 0usize,
+            in("x2") 0usize,
+            in("x3") 0usize,
+            in("x4") 0usize,
+            options(nostack, preserves_flags)
+        );
+    }
+    #[cfg(target_arch = "x86_64")]
+    unsafe {
+        core::arch::asm!(
+            "syscall",
+            inlateout("rax") SYS_GET_CPU_COUNT => count,
+            in("rdi") 0usize,
+            in("rsi") 0usize,
+            in("rdx") 0usize,
+            in("r10") 0usize,
+            lateout("rcx") _,
+            lateout("r11") _,
+            options(nostack, preserves_flags)
+        );
+    }
+    #[cfg(not(any(target_arch = "riscv64", target_arch = "aarch64", target_arch = "x86_64")))]
+    {
+        count = 1;
+    }
+    let n = NonZero::new(if count > 0 { count } else { 1 }).unwrap();
+    Ok(n)
+}
+
+pub fn sleep(dur: Duration) {
+    if dur.is_zero() {
+        yield_now();
+        return;
+    }
+    // Nothing wakes this word, so each wait runs to its timeout; one futex
+    // wait is capped (~497 days), so a longer sleep takes several.
+    const MAX_WAIT: Duration = Duration::from_secs(365 * 24 * 60 * 60);
+    let dummy = <Atomic<u32>>::new(0);
+    let mut remaining = dur;
+    while !remaining.is_zero() {
+        let wait = remaining.min(MAX_WAIT);
+        crate::sys::pal::futex::futex_wait(&dummy, 0, Some(wait));
+        remaining -= wait;
+    }
+}
+
+pub fn yield_now() {
+    #[cfg(target_arch = "riscv64")]
+    unsafe {
+        core::arch::asm!(
+            "ecall",
+            inlateout("a0") 0usize => _,
+            in("a1") 0usize,
+            in("a2") 0usize,
+            in("a3") 0usize,
+            in("a7") SYS_YIELD,
+            options(nostack, preserves_flags)
+        );
+    }
+    #[cfg(target_arch = "aarch64")]
+    unsafe {
+        core::arch::asm!(
+            "svc #0",
+            inlateout("x0") SYS_YIELD => _,
+            in("x1") 0usize,
+            in("x2") 0usize,
+            in("x3") 0usize,
+            in("x4") 0usize,
+            options(nostack, preserves_flags)
+        );
+    }
+    #[cfg(target_arch = "x86_64")]
+    unsafe {
+        core::arch::asm!(
+            "syscall",
+            inlateout("rax") SYS_YIELD => _,
+            in("rdi") 0usize,
+            in("rsi") 0usize,
+            in("rdx") 0usize,
+            in("r10") 0usize,
+            lateout("rcx") _,
+            lateout("r11") _,
+            options(nostack, preserves_flags)
+        );
+    }
+}
