+use crate::alloc::Layout;
+use crate::sys::pal::alloc as pal_alloc;
+
+#[inline]
+pub unsafe fn alloc(layout: Layout) -> *mut u8 {
+    unsafe { pal_alloc::alloc(layout) }
+}
+
+#[inline]
+pub unsafe fn dealloc(ptr: *mut u8, layout: Layout) {
+    unsafe { pal_alloc::dealloc(ptr, layout) }
+}
+
+// The PAL heap has no in-place grow; this is the same alloc + copy + dealloc
+// sequence `GlobalAlloc::realloc`'s default performed before the free-function
+// allocator interface.
+#[inline]
+pub unsafe fn realloc(ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+    unsafe { super::realloc_fallback(ptr, layout, new_size) }
+}
