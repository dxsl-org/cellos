--- /dev/null
+++ b/library/std/src/sys/pal/cellos/alloc.rs
@@ -0,0 +1,16 @@
+use crate::alloc::Layout;
+
+unsafe extern "C" {
+    fn vi_alloc(size: usize, align: usize) -> *mut u8;
+    fn vi_dealloc(ptr: *mut u8, size: usize, align: usize);
+}
+
+#[inline]
+pub unsafe fn alloc(layout: Layout) -> *mut u8 {
+    unsafe { vi_alloc(layout.size(), layout.align()) }
+}
+
+#[inline]
+pub unsafe fn dealloc(ptr: *mut u8, layout: Layout) {
+    unsafe { vi_dealloc(ptr, layout.size(), layout.align()) }
+}
