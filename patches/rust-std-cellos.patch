index 0000000..ef7cf20
--- /dev/null
+++ b/library/std/src/sys/pal/cellos/alloc.rs
@@ -0,0 +1,31 @@
+use crate::alloc::Layout;
+
+// CellOS Tier 1 SAS Per-Cell Heap Arena (1 MiB, 16-byte aligned)
+const HEAP_SIZE: usize = 1024 * 1024;
+
+#[repr(align(16))]
+struct HeapMemory([u8; HEAP_SIZE]);
+static mut HEAP_MEM: HeapMemory = HeapMemory([0; HEAP_SIZE]);
+static mut HEAP_OFFSET: usize = 0;
+
+#[inline]
+pub unsafe fn alloc(layout: Layout) -> *mut u8 {
+    let align = layout.align();
+    let size = layout.size();
+    if size == 0 {
+        return align as *mut u8;
+    }
+    let current = HEAP_OFFSET;
+    let aligned = (current + align - 1) & !(align - 1);
+    let next = aligned + size;
+    if next > HEAP_SIZE {
+        return core::ptr::null_mut();
+    }
+    HEAP_OFFSET = next;
+    core::ptr::addr_of_mut!(HEAP_MEM.0).cast::<u8>().add(aligned)
+}
+
+#[inline]
+pub unsafe fn dealloc(_ptr: *mut u8, _layout: Layout) {
+    // Per-cell allocator lifecycle is bounded to cell lifetime.
+}
