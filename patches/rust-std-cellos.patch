@@ -0,0 +1,28 @@
+pub fn fill_bytes(bytes: &mut [u8]) {
+    let mut offset = 0;
+    while offset < bytes.len() {
+        let chunk_len = core::cmp::min(bytes.len() - offset, 64);
+        let chunk = &mut bytes[offset..offset + chunk_len];
+        #[cfg(target_arch = "riscv64")]
+        unsafe {
+            let ret: isize;
+            core::arch::asm!(
+                "ecall",
+                inlateout("a0") chunk.as_mut_ptr() as usize => ret,
+                in("a1") chunk.len(),
+                in("a2") 0usize,
+                in("a3") 0usize,
+                in("a7") 37usize, // ViSyscall::GetRandom
+                options(nostack)
+            );
+            if ret <= 0 {
+                panic!("GetRandom failed");
+            }
+            offset += ret as usize;
+        }
+        #[cfg(not(target_arch = "riscv64"))]
+        {
+            panic!("GetRandom unsupported architecture");
+        }
+    }
+}
