+++ b/library/std/src/sys/pal/cellos/random.rs
@@ -0,0 +1,70 @@
+const SYS_GET_RANDOM: usize = 37;
+
+/// Secure entropy hook obeying PAL-019 (no dev-weak-rng) and PAL-031 (buffer validation).
+pub fn fill_bytes(bytes: &mut [u8]) {
+    if bytes.is_empty() {
+        return;
+    }
+    // PAL-031: Validate pointer bounds and non-null before issuing syscall
+    let ptr = bytes.as_mut_ptr();
+    if ptr.is_null() {
+        panic!("PAL-031: null pointer rejected");
+    }
+    let addr = ptr as usize;
+    if addr.checked_add(bytes.len()).is_none() {
+        panic!("PAL-031: buffer range overflow rejected");
+    }
+
+    let mut offset = 0;
+    while offset < bytes.len() {
+        let chunk_len = core::cmp::min(bytes.len() - offset, 64);
+        let chunk = &mut bytes[offset..offset + chunk_len];
+        let chunk_ptr = chunk.as_mut_ptr() as usize;
+        let ret: isize;
+
+        #[cfg(target_arch = "riscv64")]
+        unsafe {
+            core::arch::asm!(
+                "ecall",
+                inlateout("a0") chunk_ptr => ret,
+                in("a1") chunk_len,
+                in("a2") 0usize,
+                in("a3") 0usize,
+                in("a7") SYS_GET_RANDOM,
+                options(nostack, preserves_flags)
+            );
+        }
+        #[cfg(target_arch = "aarch64")]
+        unsafe {
+            core::arch::asm!(
+                "svc #0",
+                inlateout("x0") SYS_GET_RANDOM => ret,
+                in("x1") chunk_ptr,
+                in("x2") chunk_len,
+                in("x3") 0usize,
+                in("x4") 0usize,
+                options(nostack, preserves_flags)
+            );
+        }
+        #[cfg(target_arch = "x86_64")]
+        unsafe {
+            core::arch::asm!(
+                "syscall",
+                inlateout("rax") SYS_GET_RANDOM => ret,
+                in("rdi") chunk_ptr,
+                in("rsi") chunk_len,
+                in("rdx") 0usize,
+                in("r10") 0usize,
+                lateout("rcx") _,
+                lateout("r11") _,
+                options(nostack, preserves_flags)
+            );
+        }
+
+        // PAL-019: Fail-closed without synthetic fallback
+        if ret <= 0 {
+            panic!("PAL-019: GetRandom returned zero or error; entropy unavailable");
+        }
+        offset += ret as usize;
+    }
+}
