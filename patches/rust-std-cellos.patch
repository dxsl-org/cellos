diff --git a/library/std/src/sys/pal/cellos/alloc.rs b/library/std/src/sys/pal/cellos/alloc.rs
new file mode 100644
index 0000000..2235c4e
--- /dev/null
+++ b/library/std/src/sys/pal/cellos/alloc.rs
@@ -0,0 +1,164 @@
+// SPDX-License-Identifier: MPL-2.0
+// CellOS Tier 1 SAS Per-Cell Freeing Heap Allocator (4 MiB, align-honouring, coalescing).
+use crate::alloc::Layout;
+use crate::sync::atomic::{Atomic, AtomicBool, Ordering};
+
+const HEAP_SIZE: usize = 4 * 1024 * 1024;
+const ALIGN: usize = 16;
+const HEADER_SIZE: usize = 16;
+
+#[repr(align(16))]
+struct HeapStorage([u8; HEAP_SIZE]);
+static mut HEAP_MEM: HeapStorage = HeapStorage([0; HEAP_SIZE]);
+static mut INITIALIZED: bool = false;
+
+// Threads are concurrent kernel tasks, so the free list is guarded; a
+// contended caller yields its time slice instead of spinning it away.
+static HEAP_LOCK: Atomic<bool> = AtomicBool::new(false);
+
+struct HeapGuard;
+
+impl HeapGuard {
+    fn acquire() -> HeapGuard {
+        while HEAP_LOCK
+            .compare_exchange_weak(false, true, Ordering::Acquire, Ordering::Relaxed)
+            .is_err()
+        {
+            super::thread::yield_now();
+        }
+        HeapGuard
+    }
+}
+
+impl Drop for HeapGuard {
+    fn drop(&mut self) {
+        HEAP_LOCK.store(false, Ordering::Release);
+    }
+}
+
+#[repr(C)]
+struct BlockHeader {
+    size: usize,
+    is_free: usize,
+}
+
+unsafe fn init_heap() {
+    let base = core::ptr::addr_of_mut!(HEAP_MEM.0) as *mut BlockHeader;
+    (*base).size = HEAP_SIZE;
+    (*base).is_free = 1;
+    INITIALIZED = true;
+}
+
+#[inline]
+fn align_up(value: usize, align: usize) -> usize {
+    (value + align - 1) & !(align - 1)
+}
+
+#[inline]
+pub unsafe fn alloc(layout: Layout) -> *mut u8 {
+    let size = layout.size();
+    if size == 0 {
+        return layout.align().max(ALIGN) as *mut u8;
+    }
+    let _guard = HeapGuard::acquire();
+    if !INITIALIZED {
+        init_heap();
+    }
+
+    // `Layout::align()` is a contract, not a hint: a `#[repr(align(N))]` type,
+    // a SIMD vector, or an over-aligned slice must receive a pointer that
+    // satisfies it. Ordinary requests (align <= ALIGN) keep the payload at
+    // HEADER_SIZE, exactly as before; an over-aligned request rounds the payload
+    // up in *absolute* terms — a free block's start is only ALIGN-aligned, so
+    // the offset differs per block — and records that offset in the word
+    // immediately before the payload, which `dealloc` reads back. An
+    // over-aligned request therefore reserves HEADER_SIZE + 8 before the
+    // payload, so that word always sits past the 16-byte header.
+    let align = layout.align().max(ALIGN);
+    let min_payload_off = if align > ALIGN { HEADER_SIZE + 8 } else { HEADER_SIZE };
+    let req_payload = align_up(size, ALIGN);
+
+    let heap_start = core::ptr::addr_of_mut!(HEAP_MEM.0) as usize;
+    let heap_end = heap_start + HEAP_SIZE;
+
+    let mut curr = heap_start;
+    while curr < heap_end {
+        let hdr = curr as *mut BlockHeader;
+        let bsize = (*hdr).size;
+        if bsize < HEADER_SIZE || curr + bsize > heap_end {
+            return core::ptr::null_mut();
+        }
+
+        let payload_off = align_up(curr + min_payload_off, align) - curr;
+        let needed = payload_off + req_payload;
+
+        if (*hdr).is_free == 1 && bsize >= needed {
+            if bsize >= needed + HEADER_SIZE + ALIGN {
+                let next = (curr + needed) as *mut BlockHeader;
+                (*next).size = bsize - needed;
+                (*next).is_free = 1;
+                (*hdr).size = needed;
+            }
+            (*hdr).is_free = 0;
+            let payload = curr + payload_off;
+            if align > ALIGN {
+                *((payload - 8) as *mut usize) = payload_off;
+            }
+            return payload as *mut u8;
+        }
+
+        curr += bsize;
+    }
+
+    core::ptr::null_mut()
+}
+
+#[inline]
+pub unsafe fn dealloc(ptr: *mut u8, layout: Layout) {
+    if layout.size() == 0 || ptr.is_null() {
+        return;
+    }
+    let _guard = HeapGuard::acquire();
+    let heap_start = core::ptr::addr_of_mut!(HEAP_MEM.0) as usize;
+    let heap_end = heap_start + HEAP_SIZE;
+    let p = ptr as usize;
+
+    if p < heap_start + HEADER_SIZE || p >= heap_end {
+        return;
+    }
+
+    // An over-aligned block stored its payload offset in the word before the
+    // payload; a tag that cannot describe a block inside the arena is refused
+    // rather than turned into a wild write.
+    let payload_off = if layout.align() > ALIGN {
+        let tag = *((p - 8) as *const usize);
+        if tag < HEADER_SIZE || tag > p - heap_start {
+            return;
+        }
+        tag
+    } else {
+        HEADER_SIZE
+    };
+    let hdr = (p - payload_off) as *mut BlockHeader;
+    (*hdr).is_free = 1;
+
+    let mut curr = heap_start;
+    while curr < heap_end {
+        let cur_hdr = curr as *mut BlockHeader;
+        let bsize = (*cur_hdr).size;
+        if bsize < HEADER_SIZE || curr + bsize > heap_end {
+            break;
+        }
+
+        let next = curr + bsize;
+        if next < heap_end {
+            let next_hdr = next as *mut BlockHeader;
+            if (*cur_hdr).is_free == 1 && (*next_hdr).is_free == 1 {
+                (*cur_hdr).size += (*next_hdr).size;
+                continue;
+            }
+        }
+
+        curr += (*cur_hdr).size;
+    }
+}
