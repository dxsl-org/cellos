diff --git a/library/std/src/sys/pal/cellos/futex.rs b/library/std/src/sys/pal/cellos/futex.rs
new file mode 100644
index 0000000..9a47389
--- /dev/null
+++ b/library/std/src/sys/pal/cellos/futex.rs
@@ -0,0 +1,166 @@
+use crate::sync::atomic::Atomic;
+use crate::time::Duration;
+
+/// An atomic for use as a futex that is at least 32-bits but may be larger
+pub type Futex = Atomic<Primitive>;
+/// Must be the underlying type of Futex
+pub type Primitive = u32;
+
+/// An atomic for use as a futex that is at least 8-bits but may be larger.
+pub type SmallFutex = Atomic<SmallPrimitive>;
+/// Must be the underlying type of SmallFutex
+pub type SmallPrimitive = u32;
+
+const SYS_FUTEX_WAIT: usize = 17;
+const SYS_FUTEX_WAKE: usize = 18;
+
+pub fn futex_wait(futex: &Atomic<u32>, expected: u32, timeout: Option<Duration>) -> bool {
+    // The kernel wakes the waiter once `system_ticks >= now + ticks` (10 ms
+    // ticks) and the wait may begin late in the current tick, so round up and
+    // add one tick: a timed wait must never end before `timeout`. The cap keeps
+    // the kernel's deadline sum from overflowing; a longer wait (~497 days)
+    // reports a timeout early instead.
+    let ticks = match timeout {
+        Some(d) => (d.as_nanos().div_ceil(10_000_000) + 1).min(u32::MAX as u128) as usize,
+        None => 0,
+    };
+
+    let ret: usize;
+    #[cfg(target_arch = "riscv64")]
+    unsafe {
+        core::arch::asm!(
+            "ecall",
+            inlateout("a0") futex.as_ptr() as usize => ret,
+            in("a1") expected as usize,
+            in("a2") ticks,
+            in("a3") 0usize,
+            in("a7") SYS_FUTEX_WAIT,
+            options(nostack, preserves_flags)
+        );
+    }
+    #[cfg(target_arch = "aarch64")]
+    unsafe {
+        core::arch::asm!(
+            "svc #0",
+            inlateout("x0") SYS_FUTEX_WAIT => ret,
+            in("x1") futex.as_ptr() as usize,
+            in("x2") expected as usize,
+            in("x3") ticks,
+            in("x4") 0usize,
+            options(nostack, preserves_flags)
+        );
+    }
+    #[cfg(target_arch = "x86_64")]
+    unsafe {
+        core::arch::asm!(
+            "syscall",
+            inlateout("rax") SYS_FUTEX_WAIT => ret,
+            in("rdi") futex.as_ptr() as usize,
+            in("rsi") expected as usize,
+            in("rdx") ticks,
+            in("r10") 0usize,
+            lateout("rcx") _,
+            lateout("r11") _,
+            options(nostack, preserves_flags)
+        );
+    }
+    #[cfg(not(any(target_arch = "riscv64", target_arch = "aarch64", target_arch = "x86_64")))]
+    {
+        ret = 0;
+    }
+
+    ret != 2
+}
+
+#[inline]
+pub fn futex_wake(futex: &Atomic<u32>) -> bool {
+    let ret: usize;
+    #[cfg(target_arch = "riscv64")]
+    unsafe {
+        core::arch::asm!(
+            "ecall",
+            inlateout("a0") futex.as_ptr() as usize => ret,
+            in("a1") 1usize,
+            in("a2") 0usize,
+            in("a3") 0usize,
+            in("a7") SYS_FUTEX_WAKE,
+            options(nostack, preserves_flags)
+        );
+    }
+    #[cfg(target_arch = "aarch64")]
+    unsafe {
+        core::arch::asm!(
+            "svc #0",
+            inlateout("x0") SYS_FUTEX_WAKE => ret,
+            in("x1") futex.as_ptr() as usize,
+            in("x2") 1usize,
+            in("x3") 0usize,
+            in("x4") 0usize,
+            options(nostack, preserves_flags)
+        );
+    }
+    #[cfg(target_arch = "x86_64")]
+    unsafe {
+        core::arch::asm!(
+            "syscall",
+            inlateout("rax") SYS_FUTEX_WAKE => ret,
+            in("rdi") futex.as_ptr() as usize,
+            in("rsi") 1usize,
+            in("rdx") 0usize,
+            in("r10") 0usize,
+            lateout("rcx") _,
+            lateout("r11") _,
+            options(nostack, preserves_flags)
+        );
+    }
+    #[cfg(not(any(target_arch = "riscv64", target_arch = "aarch64", target_arch = "x86_64")))]
+    {
+        ret = 0;
+    }
+
+    ret > 0 && ret != usize::MAX
+}
+
+#[inline]
+pub fn futex_wake_all(futex: &Atomic<u32>) {
+    #[cfg(target_arch = "riscv64")]
+    unsafe {
+        core::arch::asm!(
+            "ecall",
+            inlateout("a0") futex.as_ptr() as usize => _,
+            in("a1") 0usize,
+            in("a2") 0usize,
+            in("a3") 0usize,
+            in("a7") SYS_FUTEX_WAKE,
+            options(nostack, preserves_flags)
+        );
+    }
+    #[cfg(target_arch = "aarch64")]
+    unsafe {
+        core::arch::asm!(
+            "svc #0",
+            inlateout("x0") SYS_FUTEX_WAKE => _,
+            in("x1") futex.as_ptr() as usize,
+            in("x2") 0usize,
+            in("x3") 0usize,
+            in("x4") 0usize,
+            options(nostack, preserves_flags)
+        );
+    }
+    #[cfg(target_arch = "x86_64")]
+    unsafe {
+        core::arch::asm!(
+            "syscall",
+            inlateout("rax") SYS_FUTEX_WAKE => _,
+            in("rdi") futex.as_ptr() as usize,
+            in("rsi") 0usize,
+            in("rdx") 0usize,
+            in("r10") 0usize,
+            lateout("rcx") _,
+            lateout("r11") _,
+            options(nostack, preserves_flags)
+        );
+    }
+    #[cfg(not(any(target_arch = "riscv64", target_arch = "aarch64", target_arch = "x86_64")))]
+    {}
+}
