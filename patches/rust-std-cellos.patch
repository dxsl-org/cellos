+++ b/library/std/src/sys/args/cellos.rs
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: MPL-2.0
+// CellOS Tier 1 Rust std command-line arguments implementation.
+pub use super::common::Args;
+use crate::ffi::OsString;
+use crate::vec::Vec;
+
+const SYS_STATE_RESTORE: usize = 411;
+const ARGV_STASH_KEY: usize = 0x0061_7267_7600_0000;
+
+pub fn args() -> Args {
+    let mut buf = [0u8; 1024];
+    let ret: isize;
+    #[cfg(target_arch = "riscv64")]
+    unsafe {
+        core::arch::asm!(
+            "ecall",
+            inlateout("a0") ARGV_STASH_KEY => ret,
+            in("a1") buf.as_mut_ptr() as usize,
+            in("a2") buf.len(),
+            in("a3") 0usize,
+            in("a7") SYS_STATE_RESTORE,
+            options(nostack, preserves_flags)
+        );
+    }
+    #[cfg(target_arch = "aarch64")]
+    unsafe {
+        core::arch::asm!(
+            "svc #0",
+            inlateout("x0") SYS_STATE_RESTORE => ret,
+            in("x1") ARGV_STASH_KEY,
+            in("x2") buf.as_mut_ptr() as usize,
+            in("x3") buf.len(),
+            in("x4") 0usize,
+            options(nostack, preserves_flags)
+        );
+    }
+    #[cfg(target_arch = "x86_64")]
+    unsafe {
+        core::arch::asm!(
+            "syscall",
+            inlateout("rax") SYS_STATE_RESTORE => ret,
+            in("rdi") ARGV_STASH_KEY,
+            in("rsi") buf.as_mut_ptr() as usize,
+            in("rdx") buf.len(),
+            in("r10") 0usize,
+            lateout("rcx") _,
+            lateout("r11") _,
+            options(nostack, preserves_flags)
+        );
+    }
+
+    let mut args = Vec::new();
+    if ret > 0 {
+        let n = ret as usize;
+        if let Ok(cmdline) = core::str::from_utf8(&buf[..n]) {
+            for part in cmdline.split_whitespace() {
+                args.push(OsString::from(part));
+            }
+        }
+    }
+    if args.is_empty() {
+        args.push(OsString::from("cell"));
+    }
+    Args::new(args)
+}
