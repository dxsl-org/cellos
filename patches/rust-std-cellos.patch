+++ b/library/std/src/sys/stdio/cellos.rs
@@ -0,0 +1,104 @@
+use crate::io;
+
+const SYS_LOG: usize = 11;
+
+#[inline]
+unsafe fn log_bytes(buf: &[u8]) {
+    if buf.is_empty() {
+        return;
+    }
+    let ptr = buf.as_ptr() as usize;
+    let len = buf.len();
+    #[cfg(target_arch = "riscv64")]
+    core::arch::asm!(
+        "ecall",
+        in("a0") ptr,
+        in("a1") len,
+        in("a2") 0usize,
+        in("a3") 0usize,
+        in("a7") SYS_LOG,
+        options(nostack, preserves_flags)
+    );
+    #[cfg(target_arch = "aarch64")]
+    core::arch::asm!(
+        "svc #0",
+        in("x0") SYS_LOG,
+        in("x1") ptr,
+        in("x2") len,
+        in("x3") 0usize,
+        in("x4") 0usize,
+        options(nostack, preserves_flags)
+    );
+    #[cfg(target_arch = "x86_64")]
+    core::arch::asm!(
+        "syscall",
+        in("rax") SYS_LOG,
+        in("rdi") ptr,
+        in("rsi") len,
+        in("rdx") 0usize,
+        in("r10") 0usize,
+        lateout("rcx") _,
+        lateout("r11") _,
+        options(nostack, preserves_flags)
+    );
+}
+
+pub struct Stdin;
+pub struct Stdout;
+pub struct Stderr;
+
+impl Stdin {
+    pub const fn new() -> Stdin {
+        Stdin
+    }
+}
+
+impl io::Read for Stdin {
+    fn read(&mut self, _buf: &mut [u8]) -> io::Result<usize> {
+        Err(io::Error::from(io::ErrorKind::Unsupported))
+    }
+}
+
+impl Stdout {
+    pub const fn new() -> Stdout {
+        Stdout
+    }
+}
+
+impl io::Write for Stdout {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        unsafe { log_bytes(buf) };
+        Ok(buf.len())
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+impl Stderr {
+    pub const fn new() -> Stderr {
+        Stderr
+    }
+}
+
+impl io::Write for Stderr {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        unsafe { log_bytes(buf) };
+        Ok(buf.len())
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+pub const STDIN_BUF_SIZE: usize = crate::sys::io::DEFAULT_BUF_SIZE;
+
+pub fn is_ebadf(_err: &io::Error) -> bool {
+    true
+}
+
+pub fn panic_output() -> Option<impl io::Write> {
+    Some(Stderr::new())
+}
