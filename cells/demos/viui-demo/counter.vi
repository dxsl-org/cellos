// Counter — canonical ViUI v2 demo component
component Counter {
    in-out property <int> count: 0;

    VerticalLayout {
        padding: 16px;
        spacing: 8px;

        // No colour: the label draws in the session theme's text colour.
        Text { text: "Count: \{count}"; }
        Button {
            text: "Increment";
            clicked => { count += 1; }
        }
    }
}
