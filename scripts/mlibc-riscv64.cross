# Meson cross file for mlibc targeting ViCell riscv64.
# Used in WSL2 — the xpack riscv-none-elf-gcc toolchain lives under /mnt/c/RISCV.
# Update the binary paths below if you installed the toolchain elsewhere.
#
# Usage: bash scripts/build-mlibc.sh (handles clone + patch automatically)

[binaries]
c       = 'riscv64-unknown-elf-gcc'
cpp     = 'riscv64-unknown-elf-g++'
ar      = 'riscv64-unknown-elf-ar'
ld      = 'riscv64-unknown-elf-ld'
strip   = 'riscv64-unknown-elf-strip'
objcopy = 'riscv64-unknown-elf-objcopy'

[host_machine]
# 'vicell' triggers the vicell branch in third_party/mlibc/meson.build.
# This is NOT a Linux host — do not use Linux syscall numbers.
system     = 'vicell'
cpu_family = 'riscv64'
cpu        = 'riscv64'
endian     = 'little'

[built-in options]
c_args   = ['-march=rv64gc', '-mabi=lp64d', '-mcmodel=medany']
cpp_args = ['-march=rv64gc', '-mabi=lp64d', '-mcmodel=medany']
