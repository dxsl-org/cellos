{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cellos://rust-std-promotion/benchmark-run/v1",
  "title": "Cellos rust-std synthetic benchmark fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_kind", "fixture_id", "requested_designation", "expected_cells", "runs"],
  "properties": {
    "schema_version": {"const": "rust-std-benchmark-run/v1"},
    "source_kind": {"const": "synthetic_fixture"},
    "fixture_id": {"type": "string", "minLength": 1},
    "requested_designation": {"const": "fixture_validation_only"},
    "expected_cells": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/cell"}},
    "runs": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/run"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cell": {"type": "object", "additionalProperties": false, "required": ["cell_id", "workload_id"], "properties": {"cell_id": {"type": "string", "minLength": 1}, "workload_id": {"enum": ["syscall-yield-v1", "ipc-echo-64-v1"]}}},
    "toolchain": {"type": "object", "additionalProperties": false, "required": ["channel", "rustc_version", "commit_hash", "rust_src_digest"], "properties": {"channel": {"const": "nightly-2026-05-01"}, "rustc_version": {"const": "1.97.0-nightly"}, "commit_hash": {"const": "f53b654a8"}, "rust_src_digest": {"$ref": "#/$defs/digest"}}},
    "linker_input": {"type": "object", "additionalProperties": false, "required": ["role", "identity", "digest"], "properties": {"role": {"enum": ["linker-script", "target-spec", "compiler-builtins", "entrypoint", "runtime"]}, "identity": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}},
    "environment": {"type": "object", "additionalProperties": false, "required": ["architecture", "environment_kind", "board_model", "board_revision", "qemu_binary_digest", "qemu_version", "machine", "firmware_digest", "cpu_model", "cpu_count", "hart_count", "frequency_policy", "timer_source", "timer_frequency_hz", "target_spec_digest", "service_topology_digest", "service_state_digest"], "properties": {
      "architecture": {"enum": ["x86_64", "aarch64", "riscv64"]}, "environment_kind": {"enum": ["qemu", "hardware"]}, "board_model": {"type": "string"}, "board_revision": {"type": "string"}, "qemu_binary_digest": {"$ref": "#/$defs/digest"}, "qemu_version": {"type": "string"}, "machine": {"type": "string"}, "firmware_digest": {"$ref": "#/$defs/digest"}, "cpu_model": {"type": "string"}, "cpu_count": {"type": "integer", "minimum": 1}, "hart_count": {"type": "integer", "minimum": 1}, "frequency_policy": {"type": "string", "minLength": 1}, "timer_source": {"type": "string", "minLength": 1}, "timer_frequency_hz": {"type": "integer", "minimum": 1}, "target_spec_digest": {"$ref": "#/$defs/digest"}, "service_topology_digest": {"$ref": "#/$defs/digest"}, "service_state_digest": {"$ref": "#/$defs/digest"}
    }},
    "protocol": {"type": "object", "additionalProperties": false, "required": ["warmup_count", "independent_rep_count", "operations_per_rep", "reset_rule", "predeclared_interference_codes"], "properties": {"warmup_count": {"type": "integer", "minimum": 5}, "independent_rep_count": {"type": "integer", "minimum": 30}, "operations_per_rep": {"const": 1}, "reset_rule": {"const": "fresh-cell-instance-per-repetition; pinned-peer-state-restored"}, "predeclared_interference_codes": {"type": "array", "uniqueItems": true, "items": {"enum": ["host_load", "steal_time", "thermal_throttle", "frequency_transition", "competing_process", "service_restart", "topology_change", "timer_anomaly"]}}}},
    "interference": {"type": "object", "additionalProperties": false, "required": ["threshold_profile", "host_load", "steal_time", "thermal_throttle", "frequency_transition", "competing_process", "service_restart", "topology_change", "timer_anomaly"], "properties": {"threshold_profile": {"type": "string", "minLength": 1}, "host_load": {"const": false}, "steal_time": {"const": false}, "thermal_throttle": {"const": false}, "frequency_transition": {"const": false}, "competing_process": {"const": false}, "service_restart": {"const": false}, "topology_change": {"const": false}, "timer_anomaly": {"const": false}}},
    "repetition": {"type": "object", "additionalProperties": false, "required": ["rep_id", "fresh_instance_id", "raw_latency_ns", "monotonic_clock", "interference"], "properties": {"rep_id": {"type": "string", "minLength": 1}, "fresh_instance_id": {"type": "string", "minLength": 1}, "raw_latency_ns": {"type": "integer", "minimum": 1}, "monotonic_clock": {"const": true}, "interference": {"$ref": "#/$defs/interference"}}},
    "rejection": {"type": "object", "additionalProperties": false, "required": ["rep_id", "reason_code", "observed", "threshold"], "properties": {"rep_id": {"type": "string", "minLength": 1}, "reason_code": {"enum": ["host_load", "steal_time", "thermal_throttle", "frequency_transition", "competing_process", "service_restart", "topology_change", "timer_anomaly"]}, "observed": {"type": "string"}, "threshold": {"type": "string"}}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["valid_n", "p50_ns", "p95_ns", "p99_ns"], "properties": {"valid_n": {"type": "integer", "minimum": 30}, "p50_ns": {"type": "integer", "minimum": 1}, "p95_ns": {"type": "integer", "minimum": 1}, "p99_ns": {"type": "integer", "minimum": 1}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["producer", "schema_digest", "raw_digest"], "properties": {"producer": {"const": "cellos-rust-std-synthetic-fixture-builder/v1"}, "schema_digest": {"$ref": "#/$defs/digest"}, "raw_digest": {"$ref": "#/$defs/digest"}}},
    "run": {"type": "object", "additionalProperties": false, "required": ["schema_version", "run_id", "captured_at", "cell_id", "workload_id", "workload_version", "arm", "arm_order", "toolchain", "source_revision", "source_digest", "binary_digest", "runtime_kind", "build_profile", "codegen_flags_digest", "common_linker_inputs", "common_linker_inputs_digest", "runtime_linker_inputs", "runtime_linker_inputs_digest", "admission_manifest_digest", "capability_manifest_digest", "payload_digest", "operation_trace_digest", "environment", "protocol", "repetitions", "rejections", "summary", "provenance"], "properties": {
      "schema_version": {"const": "rust-std-benchmark-run/v1"}, "run_id": {"type": "string", "minLength": 1}, "captured_at": {"type": "string", "format": "date-time", "pattern": "Z$"}, "cell_id": {"type": "string", "minLength": 1}, "workload_id": {"enum": ["syscall-yield-v1", "ipc-echo-64-v1"]}, "workload_version": {"const": 1}, "arm": {"enum": ["no_std_pre", "std", "no_std_post"]}, "arm_order": {"type": "integer", "minimum": 1, "maximum": 3}, "toolchain": {"$ref": "#/$defs/toolchain"}, "source_revision": {"$ref": "#/$defs/digest"}, "source_digest": {"$ref": "#/$defs/digest"}, "binary_digest": {"$ref": "#/$defs/digest"}, "runtime_kind": {"enum": ["no_std", "std"]}, "build_profile": {"const": "release"}, "codegen_flags_digest": {"$ref": "#/$defs/digest"}, "common_linker_inputs": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/linker_input"}}, "common_linker_inputs_digest": {"$ref": "#/$defs/digest"}, "runtime_linker_inputs": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/linker_input"}}, "runtime_linker_inputs_digest": {"$ref": "#/$defs/digest"}, "admission_manifest_digest": {"$ref": "#/$defs/digest"}, "capability_manifest_digest": {"$ref": "#/$defs/digest"}, "payload_digest": {"$ref": "#/$defs/digest"}, "operation_trace_digest": {"$ref": "#/$defs/digest"}, "environment": {"$ref": "#/$defs/environment"}, "protocol": {"$ref": "#/$defs/protocol"}, "repetitions": {"type": "array", "minItems": 30, "items": {"$ref": "#/$defs/repetition"}}, "rejections": {"type": "array", "maxItems": 0, "items": {"$ref": "#/$defs/rejection"}}, "summary": {"$ref": "#/$defs/summary"}, "provenance": {"$ref": "#/$defs/provenance"}
    }}
  }
}
