#!/bin/sh
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

echo "Initializing hostile probe environment..."

# 1. Bounds
/bin/tier3-hostile-probe 1

# 2. Descriptor shape
/bin/tier3-hostile-probe 2

# 3. Backend unavailable
/bin/tier3-hostile-probe 3

# 4. vCPU budget (run in background to spin indefinitely)
/bin/tier3-hostile-probe 5 &

# Allow some time for vCPU budget spinning to be observed
sleep 2

# 5. Reset
/bin/tier3-hostile-probe 4

echo "guest-init.sh finished. Halting."
while true; do sleep 1000; done
