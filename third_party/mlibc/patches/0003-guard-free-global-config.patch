-inline const GlobalConfig &globalConfig() {
-	static GlobalConfig cached;
-	return cached;
-}
+// Never uses a function-local static: __cxa_guard_acquire may belong to a C++
+// runtime (libc++abi) that guards through a pthread mutex, and pthread's scope
+// trace calls globalConfig(). Every switch reads as off until the environment
+// has been loaded, including on re-entry while it loads.
+const GlobalConfig &globalConfig();
 
 }
 
