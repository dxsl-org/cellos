# Build artifacts
/target
# Nested crate build artifacts (tools/*/target, vi-build-test/target, …)
target/
Cargo.lock

# Fetched Linux VM guest artifacts (scripts/fetch-alpine*.sh cache dirs)
.alpine-cache/
.alpine-cache-x86/

# Zig build artifacts
**/.zig-cache/
**/zig-out/

# Hook / scratch logs (per-directory .logs/)
.logs/

# Scratch QEMU capture dumps
qemu_*.txt
*.err

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

