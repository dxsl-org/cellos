*.log
*_log.txt
*_error.txt
check_*.txt
contract_test_log*.txt
test_log*.txt
test_error*.txt

# Disassembly / scratch dumps
*.asm

# Vendored upstream tarballs (extract into src/ instead)
*.tar.gz
*.tar.xz
*.tar.bz2
*.zip

# Reference materials
.references/
.agents/
# Keep the baseline's causal record and implementation plan reproducible while
# leaving all other agent scratch artifacts ignored.
!/.agents/
!/.agents/debug/
!/.agents/debug/debug-260822-1439-init-hart0-differential.md
!/.agents/debug/debug-260822-1742-rv64-context-tp-migration.md
!/.agents/260822-cellos-vfs-smp-006-owner-lifetime/
!/.agents/260822-cellos-vfs-smp-006-owner-lifetime/plan.md
.claude/
CLAUDE.md
.cargo/
# Integration tests need their own target override; include their config.
!tests/integration/.cargo/
!tests/integration/.cargo/config.toml

# Disk Images
*.img
/kernel/src/embedded-hv/
/kernel/src/embedded-shell-test/
/kernel/src/embedded-srv-test/

# Python bytecode from tools/ and scripts/ (mkfat32, inspect_fat, sign-policy)
__pycache__/

# Upstream extract-vmlinux, downloaded + checksum-verified by fetch-alpine-x86.sh.
# Cached so re-runs work offline; not ours to vendor (GPL-2.0, Linux scripts/).
/scripts/.extract-vmlinux

# Accidentally-created disk images from script invocations (e.g. gen_disk.ps1 --help)
--help

# Build / debug artifacts in workspace root
*.rlib
*.pcap

# Limine bootloader binary (downloaded at build/CI time via scripts/download-limine.sh)
tools/limine-riscv64

# VisionFive2 build artifacts
scripts/limine-cache/


# mlibc upstream source clone (populated by scripts/setup-mlibc.ps1 or build-mlibc.sh)
third_party/mlibc-src/
# mlibc build outputs
third_party/mlibc/build/
third_party/mlibc/build-aarch64/

# Vove — private restricted sub-repo (git@github.com:dxsl-org/vove.git)
# Maintained as a standalone git repo; zero trace in Cellos history.
# Clone separately: git clone git@github.com:dxsl-org/vove.git cells/apps/vove
cells/apps/vove/

# Files literally named like a CLI flag. tools/mkfat32.py takes its output path as
# a POSITIONAL argument (sys.argv[1]), so invoking it with `--out`/`--list` writes a
# disk image to a file of that name instead of erroring. That is how a 4 MB `--list`
# and an 8 MB `--out` got committed once; this keeps the next slip untracked.
/--*

# repomix whole-repo dump for LLM context (/hc-scout --pack). Regenerated on demand
# and stale the moment any source file changes, so a committed copy is worse than none.
/repomix-output.*

# Local agent diagnostics, generated repository packs, and boot images.
/.agents/debug/
/.agents/**/pack.json
/build/*.iso
