# Normalize line endings to LF on commit across all platforms.
# Windows developers get CRLF in working copy; CI (Linux) sees LF.
* text=auto eol=lf

# Binary files — never mangle.
*.png binary
*.jpg binary
*.ico binary
*.tar.gz binary
*.img binary
*.elf binary

# Runtime evidence must retain the exact byte stream emitted by QEMU.
docs/evidence/*-raw.txt -text
